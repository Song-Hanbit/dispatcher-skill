{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "decision": {
      "type": "string",
      "enum": ["execute", "needs_approval", "failed"]
    },
    "summary": {
      "type": "string"
    },
    "result": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "error": {
      "type": "string"
    }
  },
  "required": ["decision", "summary", "result", "reason", "error"]
}
